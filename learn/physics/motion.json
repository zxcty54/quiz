        "revision_points": [
          {
            "topic": "Motion Types & Rest/Motion",
            "point": "Motion = position change with time. Types: Linear (सीधी), Circular (गोलाकार), Oscillatory (दोलन). Rest/Motion relative होते हैं (reference frame पर depend)."
          },
          {
            "topic": "Distance vs Displacement (BPSC Trap)",
            "point": "Distance = Total path (scalar, always ≥0). Displacement = Shortest straight line (vector, can be 0). Displacement ≤ Distance always. Circular path पर पूरा चक्कर = Displacement 0."
          },
          {
            "topic": "Speed vs Velocity",
            "point": "Speed = Distance/Time (scalar). Velocity = Displacement/Time (vector). Average Velocity circular में 0 हो सकता है पर Average Speed नहीं. Instantaneous = particular moment पर."
          },
          {
            "topic": "Acceleration & Motion Types",
            "point": "Acceleration = (v-u)/t (m/s²). Positive = बढ़ रहा, Negative = घट रहा (Retardation). Uniform motion में a=0. Non-uniform में a≠0."
          },
          {
            "topic": "3 Golden Equations",
            "point": "1) v = u + at, 2) s = ut + ½at², 3) v² = u² + 2as. Uniform acceleration के लिए. Free fall: u=0, a=g. Upward throw: a=-g, top पर v=0."
          },
          {
            "topic": "Graphs (NEET Favorite)",
            "point": "Distance-Time: Slope = Speed. Velocity-Time: Slope = Acceleration, Area = Distance. Horizontal line in d-t = Rest. Straight line = Uniform motion."
          },
          {
            "topic": "Circular Motion",
            "point": "Speed constant हो सकती है पर Velocity नहीं (direction बदल रही). Centripetal acceleration/force = center की ओर. Centrifugal = pseudo force (fake)."
          },
          {
            "topic": "Relative Motion & Units",
            "point": "Same direction: v₁-v₂, Opposite: v₁+v₂. Speed unit: m/s, km/h. Acceleration: m/s². 1 km/h = 5/18 m/s. Railway favorite!"
          }
        ]
