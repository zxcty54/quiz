      "messages": [
        {
          "speaker": "aman",
          "text": "PARALLEL CIRCUIT rules: (1) SAME voltage across all resistors (V₁ = V₂ = V₃ = V_total). (2) Total current = sum of individual currents (I_total = I₁ + I₂ + I₃). (3) Equivalent resistance: 1/R_eq = 1/R₁ + 1/R₂ + 1/R₃ (RECIPROCAL add hote hain!)"
        },
        {
          "speaker": "raju",
          "text": "Ye toh complicated lag raha hai Sir!"
