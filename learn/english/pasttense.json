      "type": "chat",
      "concept_id": "used_to_would",
      "level": 6,
      "progress": { "current": 43, "total": 80 },
      "messages": [
        { "speaker": "raju", "text": "Sir, Dadi kehti hain 'Pehle hum piyaau se paani laate the, ab nal hai'. Ye kaunsa tense hoga?" },
        { "speaker": "aman", "text": "Bahut sundar example! Ye ek PURANI AADAT hai jo past mein thi par ab nahi hai. English mein bolte hain 'used to + V1' — 'We used to fetch water from the well.'" },
        { "speaker": "raju", "text": "Toh 'used to' matlab 'pehle hota tha, ab nahi hota'?" },
        { "speaker": "aman", "text": "Bilkul sahi! Aur dhyan rakhna, 'used to' ke baad hamesha V1 (base form) aata hai, V2 nahi — 'used to go' sahi, 'used to went' galat." }
      ],
      "navigation": { "next": "card_44_would_habit", "button_text": "Next Card ➔" }
