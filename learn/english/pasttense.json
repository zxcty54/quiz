      "type": "chat",
      "concept_id": "past_perfect_continuous",
      "level": 5,
      "progress": { "current": 38, "total": 80 },
      "messages": [
        { "speaker": "aman", "text": "Ruko Raju, ek zaroori rule: 'Since' point of time ke saath aata hai (since 2018, since morning), 'For' duration ke saath aata hai (for 3 hours, for two years)." },
        { "speaker": "raju", "text": "Sir 'He had been waiting since two hours' sahi hoga kya?" },
        { "speaker": "aman", "text": "Nahi! Yahi BPSC/SSC ka classic trap hai — 'two hours' duration hai, isliye 'for' aayega — 'had been waiting for two hours'. 'Since' hoga tabhi jab koi fixed point ho, jaise 'since 6 PM'." },
        { "speaker": "raju", "text": "Since = point (6 baje se), For = duration (2 ghante se) — yaad rakh liya!" }
      ],
      "navigation": { "next": "card_39_quiz1", "button_text": "Next Card ➔" }
    },

