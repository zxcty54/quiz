    {
      "card_id": "card_44_would_habit",
      "card_slug": "card_44_would_habit",
      "type": "chat",
      "concept_id": "used_to_would",
      "level": 6,
      "progress": { "current": 44, "total": 80 },
      "messages": [
        { "speaker": "aman", "text": "Ek aur word bhi past habit ke liye use hota hai — 'Would'. 'Every summer, we would visit our village.' Yahan repeated action dikhaya." },
        { "speaker": "raju", "text": "Toh 'used to' aur 'would' same hi hain sir?" },
        { "speaker": "aman", "text": "Yahin BPSC/SSC ka bada trap hai! 'Would' sirf repeated ACTIONS ke liye chalta hai, lekin STATES/FEELINGS (have, know, love, believe, own) ke liye sirf 'used to' hi use hoga, 'would' nahi." },
        { "speaker": "raju", "text": "Matlab 'I would have a bicycle' galat hoga? 'I used to have a bicycle' sahi?" }
      ],
      "navigation": { "next": "card_45_be_used_to_trap", "button_text": "Next Card ➔" }
    },

    {
      "card_id": "card_45_be_used_to_trap",
