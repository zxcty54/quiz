    {
      "card_id": "card_28_past_perfect_intro",
      "card_slug": "card_28_past_perfect_intro",
      "type": "chat",
      "concept_id": "past_perfect",
      "level": 4,
      "progress": { "current": 28, "total": 80 },
      "messages": [
        { "speaker": "aman", "text": "Raju, socho — 'Train chali gayi thi, jab main station pahuncha.' Yahan do kaam hain, dono past mein, par ek pehle hua." },
        { "speaker": "raju", "text": "Haan sir, train pehle gayi, phir main pahuncha." },
        { "speaker": "aman", "text": "Bilkul! Jab do actions past mein hon aur unme se ek DUSRE se PEHLE hua ho, to pehle wale action ke liye Past Perfect Tense use hota hai — 'had + V3'." },
        { "speaker": "raju", "text": "Matlab 'chuka tha' wala feeling — Hindi mein bhi 'gayi thi' bol rahe the!" }
