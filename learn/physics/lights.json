      "level": 7,
      "progress": {
        "current": 65,
        "total": 72
      },
      "messages": [
        {
          "speaker": "aman",
          "text": "Perfect! Dispersion kyun hota hai? Kyunki different colors ki light ki different wavelengths hoti hain. Aur prism (glass) mein different wavelengths ki light different speeds se travel karti hain - different refractive indices! Violet bends MOST (shortest wavelength, max n), Red bends LEAST (longest wavelength, min n)."
        },
        {
          "speaker": "raju",
          "text": "Toh Violet sabse zyada bend hota hai isliye neeche aata hai?"
        },
        {
          "speaker": "aman",
          "text": "Haan, prism se exit karte waqt! ⭐ NEET Favorite - Red light has maximum wavelength (least deviation), Violet has minimum wavelength (maximum deviation). Isaac Newton ne pehli baar 1666 mein dispersion ko prove kiya prism experiment se!"
        },
        {
          "speaker": "raju",
          "text": "Sir rainbow mein kaise hota hai?"
        }
