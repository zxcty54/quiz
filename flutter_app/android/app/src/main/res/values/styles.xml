<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process starts: white surface + MT logo, so the
         first frame and the Flutter MT splash screen (lib/screens/
         splash_screen.dart) look identical. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Theme applied once the process started (behind the Flutter UI). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
