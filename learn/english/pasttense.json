    {
      "card_id": "card_29_past_perfect_form",
      "card_slug": "card_29_past_perfect_form",
      "type": "chat",
      "concept_id": "past_perfect",
      "level": 4,
      "progress": { "current": 29, "total": 80 },
      "messages": [
        { "speaker": "aman", "text": "Structure: Subject + had + V3 (third form/past participle). 'Had' sabhi subjects ke saath same rehta hai — I had, You had, He had, They had." },
        { "speaker": "raju", "text": "Toh 'The train had left the station' sahi hoga?" },
        { "speaker": "aman", "text": "Perfect! 'Left' yahan V3 hai (leave-left-left). Dhyan rakhna, V3 alag hoti hai kabhi kabhi V2 se — jaise go: went(V2), gone(V3)." },
        { "speaker": "raju", "text": "Ohh isiliye 'had went' galat hai, 'had gone' sahi hoga!" }
      ],
      "navigation": { "next": "card_30_past_perfect_before_after", "button_text": "Next Card ➔" }
    },

    {
      "card_id": "card_30_past_perfect_before_after",
      "card_slug": "card_30_past_perfect_before_after",
      "type": "chat",
      "concept_id": "past_perfect",
      "level": 4,
      "progress": { "current": 30, "total": 80 },
      "messages": [
        { "speaker": "aman", "text": "Universal Rule yaad rakho: DO past actions ho to PEHLE wala action = Past Perfect (had+V3), BAAD wala action = Simple Past (V2). 'He had left before I arrived.'" },
        { "speaker": "raju", "text": "Matlab 'left' pehle hua isliye Past Perfect, 'arrived' baad mein isliye Simple Past?" },
        { "speaker": "aman", "text": "Bilkul sahi! Ye sequence kabhi ulta mat karna. 'Before' aur 'after' clauses mein bhi yahi logic chalega." },
        { "speaker": "raju", "text": "Toh agar sirf ek hi past action ho, tab Past Perfect nahi lagega?" }
      ],
      "navigation": { "next": "card_31_past_perfect_trap", "button_text": "Next Card ➔" }
    },

    {
      "card_id": "card_31_past_perfect_trap",
      "card_slug": "card_31_past_perfect_trap",
      "type": "chat",
      "concept_id": "past_perfect",
      "level": 4,
      "progress": { "current": 31, "total": 80 },
      "messages": [
        { "speaker": "aman", "text": "Sahi pakda! Past Perfect sirf tabhi aayega jab DO past events compare ho rahe hon. BPSC ka favourite trap: dono actions ko 'had' laga dena — 'He had left before I had arrived' — YE GALAT hai!" },
        { "speaker": "raju", "text": "Hain?? Dono mein 'had' nahi laga sakte?" },
        { "speaker": "aman", "text": "Nahi Raju! Sirf pehle wale action mein 'had+V3', doosre/baad wale mein sirf Simple Past. Yahi 'Double Past Perfect Error' kehlata hai." },
        { "speaker": "raju", "text": "⭐ Ye toh pakka note karna padega, exam mein confuse ho jaate hain!" }
      ],
      "navigation": { "next": "card_32_quiz1", "button_text": "Next Card ➔" }
    },

    {
      "card_id": "card_32_quiz1",
      "card_slug": "card_32_quiz1",
      "type": "quiz",
      "concept_id": "past_perfect",
      "level": 4,
      "progress": { "current": 32, "total": 80 },
      "quiz_payload": {
        "question": "Sahi sentence chuno:",
        "options": [
          { "id": "A", "text": "The patient had died before the doctor had come." },
          { "id": "B", "text": "The patient had died before the doctor came." },
          { "id": "C", "text": "The patient died before the doctor had come." },
          { "id": "D", "text": "The patient has died before the doctor came." }
        ],
        "correct_option_id": "B",
        "explanation": "Pehla event (died) = Past Perfect 'had died'; baad wala event (came) = Simple Past. Dono mein 'had' lagana Double Past Perfect Error hai."
      },
      "navigation": { "next": "card_33_quiz2", "button_text": "Check Answer & Continue ➔" }
    },

    {
      "card_id": "card_33_quiz2",
